# A+ Exames v2.3
# A integração nativa Neon/Vercel fornece normalmente DATABASE_URL automaticamente.
DATABASE_URL=

# Reservado para futuros endpoints administrativos protegidos.
APLUS_ADMIN_TOKEN=

# Neon Auth — endpoint do branch, fornecido ao ativar Auth no Neon.
NEON_AUTH_URL=

# v2.5 — Neon Auth + Data API.
# Estes endpoints são públicos por desenho; a segurança dos dados é feita por JWT + RLS.
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=

# Emails de autenticação em português (webhook /api/auth-email do Neon Auth).
# Chave do Resend (só no painel da Vercel, nunca no repositório).
RESEND_API_KEY=
# Opcional. Por omissão: APProva+ <nao-responder@approvamais.pt>
AUTH_EMAIL_FROM=
